+++ b/arch/arm64/boot/dts/renesas/r9a07g043u11-smarc.dts
@@ -35,7 +35,15 @@
 #include "rzg2ul-smarc-som.dtsi"
 #include "rzg2ul-smarc.dtsi"
 
+#define OV5645_PARENT_I2C i2c0
+#include "rz-smarc-cru-csi-ov5645.dtsi"
+
