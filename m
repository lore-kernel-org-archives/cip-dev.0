ir=3D&quot;${SWTPM_DIR}&quot; &nbsp;--ctrl type=3Dunixio,path=3D/tmp/qemu-s=
wtpm.sock &nbsp;--tpm2<o:p></o:p></span></b></p>
<p class=3D"MsoNormal"><b><span lang=3D"EN-US"><o:p>&nbsp;</o:p></span></b>=
</p>
